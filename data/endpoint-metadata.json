{
  "_source": "Derived from routePolicy() in src/index.js (Chakudya API). Not part of the OpenAPI spec on purpose - this describes runtime policy (rate limits, role gates), not shape.",
  "default": {
    "auth": "public",
    "rateLimit": {
      "limit": 100,
      "windowSeconds": 60,
      "scope": "ip"
    }
  },
  "rules": [
    {
      "method": "GET",
      "path": "/",
      "auth": "public",
      "rateLimit": null,
      "note": "Not rate-limited or auth-gated - served before the router's policy gate."
    },
    {
      "method": "GET",
      "path": "/health",
      "auth": "public",
      "rateLimit": {
        "limit": 20,
        "windowSeconds": 60,
        "scope": "ip"
      }
    },
    {
      "method": "POST",
      "path": "/batch",
      "auth": "public",
      "rateLimit": {
        "limit": 10,
        "windowSeconds": 60,
        "scope": "ip"
      },
      "note": "Caps how many batches (i.e. total fan-out) one IP can trigger per minute - each sub-request still pays its own cost against its own resource's own rate-limit bucket, so batching cannot bypass per-resource auth or limits."
    },
    {
      "method": "GET",
      "path": "/admin/keys",
      "auth": "admin",
      "requiredRole": "root",
      "rateLimit": {
        "limit": 30,
        "windowSeconds": 60,
        "scope": "admin"
      },
      "note": "Root ADMIN_API_KEY only - a per-consumer key cannot manage other keys."
    },
    {
      "method": "POST",
      "path": "/admin/keys",
      "auth": "admin",
      "requiredRole": "root",
      "rateLimit": {
        "limit": 30,
        "windowSeconds": 60,
        "scope": "admin"
      },
      "note": "Root ADMIN_API_KEY only."
    },
    {
      "method": "DELETE",
      "path": "/admin/keys/{id}",
      "auth": "admin",
      "requiredRole": "root",
      "rateLimit": {
        "limit": 30,
        "windowSeconds": 60,
        "scope": "admin"
      },
      "note": "Root ADMIN_API_KEY only."
    },
    {
      "method": "POST",
      "path": "/oauth/token",
      "auth": "public",
      "rateLimit": {
        "limit": 10,
        "windowSeconds": 60,
        "scope": "ip"
      },
      "note": "Public because the client secret IS the credential; capped tightly per IP to blunt secret-guessing. client_credentials grant, 1-hour HS256 JWT carrying the client's role."
    },
    {
      "method": "GET",
      "path": "/.well-known/oauth-authorization-server",
      "auth": "public",
      "rateLimit": {
        "limit": 60,
        "windowSeconds": 60,
        "scope": "ip"
      },
      "note": "RFC 8414 discovery metadata."
    },
    {
      "method": "GET",
      "path": "/admin/oauth-clients",
      "auth": "admin",
      "requiredRole": "root",
      "rateLimit": {
        "limit": 30,
        "windowSeconds": 60,
        "scope": "admin"
      },
      "note": "Root ADMIN_API_KEY only. The client_secret is shown once; revoking also blocks already-issued tokens (KV denylist)."
    },
    {
      "method": "POST",
      "path": "/admin/oauth-clients",
      "auth": "admin",
      "requiredRole": "root",
      "rateLimit": {
        "limit": 30,
